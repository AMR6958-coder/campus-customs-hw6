# Copy this file to .env and fill in the key. The real .env is git-ignored and never committed.
#
# The agent reads these when it starts. A variable already set in your system
# environment wins over the one in .env, so you can also just set PORTKEY_API_KEY
# in your shell and skip this file.

# The Portkey gateway key the course provides. Every AI call goes through it.
PORTKEY_API_KEY=replace-me-with-your-portkey-key

# The gateway address. Leave as is unless your course gives a different one.
PORTKEY_BASE_URL=https://api.portkey.ai/v1
