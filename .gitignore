# Secrets: the real key file is never committed. Copy .env.example to .env and fill it in.
.env
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# Half-written log files (a log is written to a .tmp file, then swapped in)
*.tmp

# The original download; the data/ folder holds the same files unzipped
data*.zip

# Editor and OS clutter
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
